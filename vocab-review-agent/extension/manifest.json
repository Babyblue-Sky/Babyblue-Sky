{
  "manifest_version": 3,
  "name": "Vocab Capture",
  "version": "2.0.0",
  "description": "Double-click a word, or select a phrase and press Ctrl+Shift+S (Cmd+Shift+S on Mac), to save it straight to your GitHub-backed Word Bank.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://dictionaryapi.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"] }
  ],
  "action": { "default_popup": "popup.html" },
  "commands": {
    "save-phrase": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save selected phrase/idiom"
    }
  },
  "background": { "service_worker": "background.js" }
}
